/implementation_plan.md

# ---------------------------------------------------------------------------
# Data: ignore everything under data/ except docs, small provenance files and
# human-produced labels. data/splits/{train,val,test}.csv are tracked (force-added)
# and frozen; see data/splits/SPLITS_SHA256.txt.
# ---------------------------------------------------------------------------
data/**/*
!data/**/
!data/**/*.md
!data/**/*.MD
!data/**/class_weights.json
!data/splits/SPLITS_SHA256.txt
!data/processed/sanity_checks/**/*
!data/processed/eval_cross_device/**/*
# Human binary audit labels (R1) are irreplaceable -> tracked
!data/processed/audit/**/*
data/raw/fetal_planes_db/LICENSE_NOTE.txt

# ---------------------------------------------------------------------------
# Models, runs, results
# ---------------------------------------------------------------------------
*.pt
events.out.tfevents.*
runs/
results/preds/
results/cache/
# results/tables, results/json and results/figures/*.pdf are tracked

# ---------------------------------------------------------------------------
# Archive: local-only bulk that was never tracked before the pivot
# ---------------------------------------------------------------------------
archive/outputs/
archive/assets/Newsprint_design_prompt.md
archive/data/processed/**/*.mp4
archive/data/processed/synthetic_clips/single_planes/
archive/data/processed/bboxes.json
archive/data/processed/eval_tier2/
archive/data/processed/natalia_showcase_clips/
archive/data/processed/tier2a_tuning/
archive/data/processed/tier1_tuning/sweep_results.csv
archive/data/processed/cross_device_manifest.csv

# ---------------------------------------------------------------------------
# Docs: third-party PDFs are kept locally only
# ---------------------------------------------------------------------------
docs/research/background/*.pdf
docs/PHASE_4_KICKOFF_PROMPT.md

# ---------------------------------------------------------------------------
# Python / tooling
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
pyrightconfig.json
pyrightconfig.json.bak
.vscode/settings.json
.env
.agents/
.tmpgit/
ultrasound_project.zip
convert_utf16.py
scratch_*.py

# ---------------------------------------------------------------------------
# Images: ignored everywhere (regenerated); publication figures are tracked as PDF
# ---------------------------------------------------------------------------
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.gif
*.GIF
*.bmp
*.BMP
*.tif
*.TIF
*.tiff
*.TIFF
*.webp
*.WEBP
*.ico
*.ICO
*.svg
*.SVG
